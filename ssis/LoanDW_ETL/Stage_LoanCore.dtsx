    <DTS:Executable
      DTS:refId="Package\SQL - Get watermarks"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{53A3C2D3-7C4E-4A5D-8704-F54C1A2C3B93}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL - Get watermarks"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{4F510697-738B-485D-A373-830E06E5F252}"
          SQLTask:SqlStatementSource="SELECT&#xA;    MAX(CASE WHEN table_name = 'branch'   THEN last_updated_at END) AS wm_branch,&#xA;    MAX(CASE WHEN table_name = 'product'  THEN last_updated_at END) AS wm_product,&#xA;    MAX(CASE WHEN table_name = 'customer' THEN last_updated_at END) AS wm_customer,&#xA;    MAX(CASE WHEN table_name = 'loan'     THEN last_updated_at END) AS wm_loan&#xA;FROM etl.watermark;"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="wm_branch"
            SQLTask:DtsVariableName="User::WM_Branch" />
          <SQLTask:ResultBinding
            SQLTask:ResultName="wm_product"
            SQLTask:DtsVariableName="User::WM_Product" />
          <SQLTask:ResultBinding
            SQLTask:ResultName="wm_customer"
            SQLTask:DtsVariableName="User::WM_Customer" />
          <SQLTask:ResultBinding
            SQLTask:ResultName="wm_loan"
            SQLTask:DtsVariableName="User::WM_Loan" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
